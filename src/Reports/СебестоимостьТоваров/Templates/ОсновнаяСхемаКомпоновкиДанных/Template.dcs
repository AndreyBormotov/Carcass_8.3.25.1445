		<field xsi:type="DataSetFieldField">
			<dataPath>Субконто2</dataPath>
			<field>Субконто2</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    ВЫРАЗИТЬ(ОстаткиИОборотыПоСрокам.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
    ВЫРАЗИТЬ(ОстаткиИОборотыПоСрокам.Субконто2 КАК ДАТА) КАК СрокГодности,
    ОстаткиИОборотыПоСрокам.КоличествоНачальныйОстатокДт КАК КоличествоНачальныйОстаток,
    ОстаткиИОборотыПоСрокам.КоличествоОборотДт КАК КоличествоПриход,
    ОстаткиИОборотыПоСрокам.КоличествоОборотКт КАК КоличествоРасход,
    ОстаткиИОборотыПоСрокам.КоличествоКонечныйОстатокДт КАК КоличествоКонечныйОстаток,
    ВЫБОР
        КОГДА ОстаткиИОборотыПоТоварам.КоличествоНачальныйОстаток = 0
            ТОГДА 0
        ИНАЧЕ ОстаткиИОборотыПоСрокам.КоличествоНачальныйОстаток * ОстаткиИОборотыПоТоварам.СуммаНачальныйОстаток / ОстаткиИОборотыПоТоварам.КоличествоНачальныйОстаток
    КОНЕЦ КАК СуммаНачальныйОстаток,
    ВЫБОР
        КОГДА ОстаткиИОборотыПоТоварам.КоличествоОборотДт = 0
            ТОГДА 0
        ИНАЧЕ ОстаткиИОборотыПоСрокам.КоличествоОборотДт * ОстаткиИОборотыПоТоварам.СуммаОборотДт / ОстаткиИОборотыПоТоварам.КоличествоОборотДт
    КОНЕЦ КАК СуммаПриход,
    ВЫБОР
        КОГДА ОстаткиИОборотыПоТоварам.КоличествоОборотКт = 0
            ТОГДА 0
        ИНАЧЕ ОстаткиИОборотыПоСрокам.КоличествоОборотКт * ОстаткиИОборотыПоТоварам.СуммаОборотКт / ОстаткиИОборотыПоТоварам.КоличествоОборотКт
    КОНЕЦ КАК СуммаРасход,
    ВЫБОР
        КОГДА ОстаткиИОборотыПоТоварам.КоличествоКонечныйОстаток = 0
            ТОГДА 0
        ИНАЧЕ ОстаткиИОборотыПоСрокам.КоличествоКонечныйОстаток * ОстаткиИОборотыПоТоварам.СуммаКонечныйОстаток / ОстаткиИОборотыПоТоварам.КоличествоКонечныйОстаток
    КОНЕЦ КАК СуммаКонечныйОстаток
ИЗ
    РегистрБухгалтерии.Управленческий.ОстаткиИОбороты(, , , , Счет = ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Товары), &amp;ПорядокСубконтоНоменклатура, ) КАК ОстаткиИОборотыПоТоварам
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Управленческий.ОстаткиИОбороты(, , , , Счет = ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Товары), &amp;ПорядокСубконтоСрок, ) КАК ОстаткиИОборотыПоСрокам
        ПО ОстаткиИОборотыПоТоварам.Субконто1 = ОстаткиИОборотыПоСрокам.Субконто1</query>
	</dataSet>
