						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>Соглашение</dcsat:name>
			<dcsat:expression>Выбор Когда Соглашение = ЗНАЧЕНИЕ(Справочник.Соглашения.ПустаяСсылка) Тогда "Аванс" Иначе Представление(Соглашение) Конец</dcsat:expression>
		</parameter>
	</template>
